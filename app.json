{
  "expo": {
    "name": "Batch Chat",
    "slug": "batch-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-glow.png",
    "scheme": "batchchat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anonymous.expotemplatedefault"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A6DFF",
        "foregroundImage": "./assets/images/logo-glow.png",
        "backgroundImage": "./assets/images/logo-glow.png",
        "monochromeImage": "./assets/images/logo-glow.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.expotemplatedefault"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
