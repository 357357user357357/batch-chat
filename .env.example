# Copy this file to `.env.local` and fill in real values
# (`.env*.local` is gitignored, so keys never reach the repo).
#
# ⚠️ `EXPO_PUBLIC_*` values are inlined into the JS bundle at bundle time
# and are visible to anyone who downloads the app. Prefer to let the user
# paste their key into the app (stored in expo-secure-store) instead.
#
# The key is read by `src/services/openrouter.ts` (env is used only as a
# dev convenience fallback).
EXPO_PUBLIC_OPENROUTER_API_KEY=sk-or-your-real-key
EXPO_PUBLIC_OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Batch model: ~50% of the standard price, 24h completion window.
EXPO_PUBLIC_OPENROUTER_BATCH_MODEL=anthropic/claude-fable-5:batch