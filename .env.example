# Copy this file to `.env.local` and fill in real values
# (`.env*.local` is gitignored, so keys never reach the repo).
#
# The key is inlined into the JS bundle at bundle time (EXPO_PUBLIC_*),
# so it becomes visible to app users — for production route it via a backend.
EXPO_PUBLIC_OPENROUTER_API_KEY=sk-or-your-real-key
EXPO_PUBLIC_OPENROUTER_MODEL=openai/gpt-4o-mini